# Database connection configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=mycdrecords
MYSQL_SSL=true
MYSQL_SSL_CA=path_to_ca_certificate_here
MYSQL_SSL_REJECT_UNAUTHORIZED=false
MYSQL_CONNECTION_LIMIT=10

# Server configuration
PORT=3004
DOMAIN=localhost
JWT_SECRET='your_jwt_secret_key_here'
JWT_REFRESH_SECRET='your_refresh_secret_key_here'
JWT_RESET_SECRET='your_reset_secret_key_here'
JWT_VERIFY_SECRET='your_verify_secret_key_here'
NODE_ENV=development
ADMIN_EMAILS="admin@example.com"
FRONTEND_URL=http://localhost:5173

# Email (verification and password reset). Without SMTP_HOST the links are only logged outside production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="myCDrecords <no-reply@example.com>"

# Spotify API configuration (optional for MusicBrainz search)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here