{
  "name": "musicbrainz-api",
  "version": "1.0.0",
  "description": "Intermediary API for MusicBrainz with Express + TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "all-dev": "concurrently -k -n API,CLIENT -c cyan,green \"npm run dev\" \"npm --prefix ../myCDrecords-client run dev\"",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "ml:readiness": "ts-node src/modules/recommendations/recommendations.readiness.cli.ts",
    "ml:catalog:seed": "ts-node src/modules/recommendations/recommendations.ml.catalog.cli.ts seed",
    "ml:catalog:verify": "ts-node src/modules/recommendations/recommendations.ml.catalog.cli.ts verify",
    "ml:engine:migrate": "ts-node src/mysql2/migrations/recommendation-engine.cli.ts",
    "ml:preflight": "ts-node src/modules/recommendations/recommendations.pilot.cli.ts",
    "ml:pilot:manage": "ts-node src/modules/recommendations/recommendations.pilot.manage.cli.ts",
    "ml:mysql:verify": "ts-node src/modules/recommendations/recommendations.real.cli.ts mysql",
    "ml:mysql:diagnose": "ts-node src/modules/recommendations/recommendations.real.cli.ts diagnose",
    "ml:pilot:migrate": "ts-node src/modules/recommendations/recommendations.real.cli.ts migrate",
    "ml:train:real": "ts-node src/modules/recommendations/recommendations.real.cli.ts train",
    "ml:export:rehearsal": "ts-node src/modules/recommendations/recommendations.exchange.cli.ts",
    "ml:lab": "ts-node src/modules/recommendations/recommendations.lab.ts",
    "test:health": "nodemon src/tests/tests.ts"
  },
  "keywords": [
    "music",
    "api",
    "express",
    "typescript"
  ],
  "author": "Henrique Montrezor",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^7.0.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "mysql": "^2.18.1",
    "mysql2": "^3.22.3",
    "node-cache": "^5.1.2",
    "nodemailer": "^10.2.1",
    "nodemon": "^3.1.14",
    "rate-limit-redis": "^4.3.1",
    "sharp": "^0.34.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.19.39",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^9.1.2",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
